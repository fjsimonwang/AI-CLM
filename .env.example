# ------------------------------------------------------------------
# CLM Platform — environment configuration
# Copy to .env and fill in real values. The stack boots without an
# LLM configured (a deterministic mock AI is used until you set one).
# ------------------------------------------------------------------

# --- Database ---
POSTGRES_DB=clm
POSTGRES_USER=clm
POSTGRES_PASSWORD=clm_local_pw

# --- Backend ---
# HS256 secret for signing app JWTs. Use a long random string in real deployments.
CLM_JWT_SECRET=change-me-to-a-long-random-secret-string-at-least-32-bytes
CLM_JWT_TTL_MINUTES=720

# --- AI / LLM (OpenAI-compatible Chat Completions API) ---
# Leave LLM_API_KEY blank to run with the built-in deterministic mock provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Model used for the higher-reasoning tasks (deviation analysis, drafting). Falls back to LLM_MODEL if blank.
LLM_MODEL_REASONING=
# Embedding model for precedent / semantic search. Blank => lexical fallback only.
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIM=1536

# --- Word editor (contract document preview/edit) ---
# Shared secret between the CLM backend and the word-editor service.
WORD_EDITOR_TOKEN=clm-editor-shared-secret
# Where the browser reaches the editor (used for the inline iframe). Change host if not localhost.
WORD_EDITOR_PUBLIC_URL=http://localhost:3100

# --- Ports exposed on the host ---
CLM_BACKEND_PORT=8081
CLM_FRONTEND_PORT=3000
CLM_POSTGRES_PORT=5433
CLM_EDITOR_PORT=3100
